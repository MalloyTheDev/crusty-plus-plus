// file_read.crust
//
// A target program exercising recoverable error handling.
// Demonstrates: `Result`, the `?` propagation operator, `Err`/`Ok`,
//               borrows, and returning a nonzero exit code.
//
// ┌───────────────────────────────────────────────────────────────────────────┐
// │ NOT A v0.1 SUCCESS CRITERION YET. This example depends on UNRESOLVED open   │
// │ questions and cannot be frozen until they are decided. See                 │
// │ spec/freeze-checklist.md:                                                   │
// │   • B1  str vs &str model        → param types below use the unresolved    │
// │                                      `&str`; should become `str` if B1 is   │
// │                                      decided as recommended.                │
// │   • B2  Option/Result<> syntax   → `Result<String, str>` is not parseable  │
// │                                      under the current grammar.             │
// │   • B4  prelude is undefined     → `read_to_string`, `string_len`,         │
// │                                      `is_err`, `unwrap` are NOT defined in  │
// │                                      any spec. `read_to_string` (file I/O)  │
// │                                      is deferred entirely.                  │
// │ The control-flow shape (Result + `?` + early exit) is what this example    │
// │ pins down; the spellings above are placeholders pending freeze.            │
// └───────────────────────────────────────────────────────────────────────────┘
//
// Intended behavior once the above freeze: reads two files, prints status, exits
// 0 on success; on any read failure, prints the error and exits 1.

// Reads a file and returns its contents as an owned String, or an error message.
fn read_file(path: &str) -> Result<String, str> {
    // On the failure path the primitive returns Err("..."), which `?` propagates.
    let contents: String = read_to_string(path)?;
    return Ok(contents);
}

// Returns the length of a file's contents, propagating any read error.
fn file_len(path: &str) -> Result<i32, str> {
    let body: String = read_file(path)?;   // `?` returns early on Err
    let n: i32 = string_len(&body);         // borrow; `body` dropped at scope end
    return Ok(n);
}

fn main() -> i32 {
    let a: Result<i32, str> = file_len("a.txt");
    let b: Result<i32, str> = file_len("b.txt");

    // v0.1 inspects Result with `if` against constructors (no `match` yet).
    if is_err(&a) {
        println("error: could not read a.txt");
        return 1;
    }
    if is_err(&b) {
        println("error: could not read b.txt");
        return 1;
    }

    let total: i32 = unwrap(a) + unwrap(b);
    println("ok");
    return 0;
}
