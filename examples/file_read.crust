// file_read.crust
//
// A compliant v0.1 target program focused on recoverable error handling.
// Exercises: `Result<T, E>`, the `?` operator, the `read_all_bytes` prelude
//            function, `is_err`/`unwrap` inspection, distinct exit codes, and
//            `as` casts. No String, no `::`, no `match`, no undefined helpers.
//
// v0.1 has no integer-to-text formatting, so the program reports via fixed
// messages and signals detail through its exit code.
//
// Expected behavior: reads "input.txt"; exits 1 on read failure, 2 if the file
//                    is empty, 0 if it has content.

// Returns the file size in bytes, propagating any read error with `?`
// (legal because this function returns Result<i32, FileError>).
fn read_size(path: str) -> Result<i32, FileError> {
    let bytes: []u8 = read_all_bytes(path)?;
    return Ok(bytes.len as i32);
}

fn main() -> i32 {
    let result: Result<i32, FileError> = read_size("input.txt");
    if is_err(result) {
        println("error: could not read input.txt");
        return 1;
    }

    let size: i32 = unwrap(result);    // safe: the Err case already returned
    if size == 0 {
        println("input.txt is empty");
        return 2;
    }

    println("input.txt has content");
    return 0;
}
