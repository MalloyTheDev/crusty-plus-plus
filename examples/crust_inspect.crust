// crust_inspect.crust
//
// The flagship v0.1 target program. Exercises most of the frozen surface:
//   structs, the `str` and `[]u8` slices, `.len`, `Result<T, E>`, the `?`
//   operator, the `read_all_bytes` prelude function, explicit `is_err`/`unwrap`
//   handling, `as` casts, context-typed integer literals, `if`, and `panic`.
//
// Stays within frozen v0.1: no String, no `::`, no `match`, no indexing, no
// borrows, no undefined helpers. All values are copied (memory-model.md §1).
//
// Expected behavior: reads "data.bin"; on read failure prints an error and
//                    exits 1; otherwise reports success and exits 0.

struct Report {
    byte_count: i32,
    score: i32,
}

// Reads the file and derives a small report. Uses `?`, which is legal here
// because this function returns Result<Report, FileError>.
fn build_report(path: str) -> Result<Report, FileError> {
    let bytes: []u8 = read_all_bytes(path)?;   // `?`: extract Ok, or return Err
    let count: i32 = bytes.len as i32;         // explicit usize -> i32 cast
    let report: Report = Report {
        byte_count: count,
        score: count * 2,                      // literal `2` is typed i32 by context
    };
    return Ok(report);
}

fn main() -> i32 {
    // `main` returns i32, so it does NOT use `?`; it inspects the Result with if.
    let result: Result<Report, FileError> = build_report("data.bin");
    if is_err(result) {
        println("error: could not read data.bin");
        return 1;
    }

    let report: Report = unwrap(result);       // safe: the Err case already returned
    if report.byte_count < 0 {
        // Should be unreachable; demonstrates `panic` for invariant violations.
        panic("internal error: negative byte count");
    }

    println("inspected data.bin");
    return 0;
}
